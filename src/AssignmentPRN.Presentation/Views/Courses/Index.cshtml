@model List<AssignmentPRN.DataAccess.Entities.Course>
@{ ViewData["Title"] = "Môn học"; }
<div class="page-header">
    <div><span class="eyebrow">Quản lý đào tạo</span><h1>Môn học</h1><p>Quản lý thông tin và trạng thái hoạt động của môn học.</p></div>
    <a class="btn btn-primary" asp-action="Create">Thêm môn học</a>
</div>
<div class="content-card">
@if (Model.Count == 0) { <div class="empty-state"><h2>Chưa có môn học</h2><p>Thêm môn học đầu tiên để bắt đầu.</p></div> }
else
{
    <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th>Mã môn</th><th>Tên môn</th><th>Giảng viên</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
        <tbody>@foreach (var course in Model)
        {
            <tr><td>@course.CourseCode</td><td><strong>@course.CourseName</strong><div class="text-muted">@course.Description</div></td>
                <td>@course.Lecturer.FullName</td><td>@(course.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")</td>
                <td><div class="d-flex gap-2"><a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@course.CourseId">Sửa</a>
                <form asp-action="Delete" asp-route-id="@course.CourseId" method="post" data-confirm="Xoá môn học này? Môn đã có dữ liệu liên quan sẽ không được xoá.">
                    <button class="btn btn-outline-danger btn-sm">Xoá</button></form></div></td></tr>
        }</tbody>
    </table></div>
}
</div>
