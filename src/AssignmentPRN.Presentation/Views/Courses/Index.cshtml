@model List<AssignmentPRN.DataAccess.Entities.Course>
@{
    ViewData["Title"] = "Môn học";
    ViewData["Breadcrumb"] = new List<BreadcrumbItem> { new("Môn học") };

    var table = new DataTableViewModel
    {
        Columns =
        [
            new("Môn học"),
            new("Mô tả"),
            new("Giảng viên"),
            new("Trạng thái"),
            new("Thao tác", AlignEnd: true)
        ],
        Rows = Model.Select(course => new List<TableCell>
        {
            new StackCell(course.CourseName, course.CourseCode),
            new TextCell(course.Description, Muted: true),
            new TextCell(course.Lecturer.FullName, Nowrap: true),
            new ChipCell(course.IsActive ? "Đang hoạt động" : "Ngừng hoạt động",
                course.IsActive ? "status-chip--success" : "status-chip--muted"),
            new ActionsCell(
            [
                new("Sửa môn học", "pencil", "Edit", new { id = course.CourseId }),
                new("Xoá môn học", "trash", "Delete", new { id = course.CourseId }, Tone: "danger", IsPost: true,
                    Confirm: $"Xoá môn {course.CourseCode}? Môn đã có dữ liệu liên quan sẽ không được xoá.")
            ])
        } as IReadOnlyList<TableCell>).ToList()
    };
}
<div class="page-header">
    <div><span class="eyebrow">Quản lý đào tạo</span><h1>Môn học</h1><p>Quản lý thông tin và trạng thái hoạt động của môn học.</p></div>
    <a class="btn btn-primary" asp-action="Create"><partial name="_Icon" model="@("plus")" /> Thêm môn học</a>
</div>

<div class="content-card">
@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon"><partial name="_Icon" model="@("book")" /></div>
        <h2>Chưa có môn học</h2>
        <p>Thêm môn học đầu tiên để bắt đầu.</p>
        <a class="btn btn-primary" asp-action="Create">Thêm môn học</a>
    </div>
}
else
{
    <partial name="_DataTable" model="table" />
}
</div>
