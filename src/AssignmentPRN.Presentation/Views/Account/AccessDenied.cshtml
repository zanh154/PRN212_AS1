@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    ViewData["Title"] = "Access Denied";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AIVES</title>
    <style>
        :root { font-family: Arial, sans-serif; }
        body { align-items: center; background: #f8fafc; display: flex; justify-content: center; margin: 0; min-height: 100vh; padding: 1.5rem; }
        main { background: #fff; border-radius: 1rem; box-shadow: 0 .75rem 2rem rgba(15, 23, 42, .1); max-width: 30rem; padding: 2.5rem; text-align: center; }
        h1 { color: #b91c1c; margin-top: 0; }
        p { color: #475569; line-height: 1.5; }
        a { color: #fff; background: #2563eb; border-radius: .5rem; display: inline-block; font-weight: 600; margin-top: 1rem; padding: .75rem 1rem; text-decoration: none; }
        a:hover { background: #1d4ed8; }
    </style>
</head>
<body>
    <main>
        <h1>Access Denied</h1>
        <p>You do not have permission to access this page.</p>
        <a asp-controller="Account" asp-action="Login">Back to Login</a>
    </main>
</body>
</html>
