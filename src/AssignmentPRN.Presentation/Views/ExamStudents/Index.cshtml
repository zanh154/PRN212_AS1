@model ExamStudentSearchViewModel
@using AssignmentPRN.DataAccess.Enums
@{ ViewData["Title"] = "Sinh viên trong phiên thi"; }
<div class="page-header"><div>
    <span class="eyebrow">Quản lý sinh viên</span>
    <h1>Sinh viên trong phiên thi</h1>
    <p>Tra cứu sinh viên, phiên thi và lịch thi trong khoảng ngày bạn chọn.</p>
</div></div>
<section class="content-card" data-exam-student-search>
    <form method="get" asp-action="Index" class="exam-student-filters" data-search-form>
        <div><label class="form-label" for="search-query">Tên hoặc email</label>
            <input id="search-query" name="Query" value="@Model.Filter.Query" maxlength="255" type="search" class="form-control" placeholder="Nhập tên hoặc email sinh viên" /></div>
        <div><label class="form-label" for="search-exam">Phiên thi</label>
            <select id="search-exam" name="ExamId" class="form-select"><option value="">Tất cả phiên thi</option>
                @foreach (var exam in Model.Result.Sessions) {
                    <option value="@exam.ExamId" selected="@(Model.Filter.ExamId == exam.ExamId)">@exam.ExamName</option>
                }
            </select></div>
        <div><label class="form-label" for="search-from">Từ ngày</label>
            <input id="search-from" name="From" type="date" value="@Model.Filter.From?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div><label class="form-label" for="search-to">Đến ngày</label>
            <input id="search-to" name="To" type="date" value="@Model.Filter.To?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div><label class="form-label" for="search-status">Trạng thái</label>
            <select id="search-status" name="Status" class="form-select"><option value="">Tất cả trạng thái</option>
                @foreach (var status in Enum.GetValues<CandidateStatus>()) {
                    <option value="@status" selected="@(Model.Filter.Status == status)">@ExamSessionText.Status(status)</option>
                }
            </select></div>
        <div class="d-flex gap-2 align-items-end"><button class="btn btn-primary" type="submit">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a></div>
    </form>
    <p class="info-note">Ngày lọc là ngày thi của từng sinh viên, bao gồm cả ngày bắt đầu và ngày kết thúc.</p>
    <p data-search-message role="status"></p>
    <div data-search-results aria-live="polite"><partial name="_Results" model="Model" /></div>
</section>
@section Scripts { <script src="~/js/exam-student-search.js" asp-append-version="true"></script> }
