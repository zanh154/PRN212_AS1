@model ExamStudentSearchViewModel
@if (Model.Error is not null) {
    <div class="alert alert-danger" role="alert">@Model.Error</div>
} else {
    <div class="section-heading"><h2>Kết quả tra cứu</h2><span>@Model.Result.Total lượt sinh viên · Trang @Model.Result.Page / @Model.Result.PageCount</span></div>
    @if (Model.Result.Items.Count == 0) {
        <div class="empty-state"><h3>Không tìm thấy sinh viên phù hợp</h3><p>Thử đổi tên, phiên thi hoặc mở rộng khoảng ngày.</p></div>
    } else {
        <div class="table-responsive"><table class="table align-middle">
            <thead><tr><th>Sinh viên</th><th>Phiên thi</th><th>Môn học</th><th>Ngày / giờ</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>@foreach (var item in Model.Result.Items) {
                <tr><td><strong>@item.StudentName</strong><div class="text-muted">@item.Email</div></td>
                    <td>@item.ExamName</td><td>@item.CourseName</td><td>@(item.ScheduledTime?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa xếp giờ")</td>
                    <td><span class="status-chip @ExamSessionText.ChipModifier(item.Status)">@ExamSessionText.Status(item.Status)</span></td>
                    <td><a asp-controller="ExamSessions" asp-action="Details" asp-route-id="@item.ExamId" class="btn btn-outline-primary btn-sm">Xem phiên thi</a></td></tr>
            }</tbody>
        </table></div>
        <nav class="d-flex gap-3 justify-content-end" aria-label="Phân trang sinh viên">
            @foreach (var page in new[] { Model.Result.Page - 1, Model.Result.Page + 1 }) {
                if (page >= 1 && page <= Model.Result.PageCount) {
                    <a asp-action="Index" asp-route-Query="@Model.Filter.Query" asp-route-ExamId="@Model.Filter.ExamId"
                       asp-route-From="@Model.Filter.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.Filter.To?.ToString("yyyy-MM-dd")"
                       asp-route-Status="@Model.Filter.Status" asp-route-Page="@(page)" class="btn btn-outline-secondary" data-search-page>
                        @(page < Model.Result.Page ? "← Trang trước" : "Trang sau →")</a>
                }
            }
        </nav>
    }
}
