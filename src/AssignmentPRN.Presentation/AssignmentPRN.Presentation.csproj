<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AssignmentPRN.Business\AssignmentPRN.Business.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compiles Styles/site.scss into wwwroot/css/site.css on every build. -->
    <PackageReference Include="AspNetCore.SassCompiler" Version="1.77.8" />
  </ItemGroup>
  <ItemGroup>
    <!-- Partials are inputs to the compiler, never served directly. -->
    <Content Remove="Styles\**" />
    <None Include="Styles\**" />
  </ItemGroup>
</Project>
